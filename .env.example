# ICT-Kronos environment. Copy to `.env` and fill in.
# NEVER commit `.env`. Secrets are env-only (CLAUDE.md rule 10).

# --- Storage -----------------------------------------------------------------
DATA_ROOT=data

# --- Database (Phase 3+; Phase 1 runs file-only) -----------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ict_kronos
ICT_SCHEMA=ict_kronos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ict_kronos
POSTGRES_PORT=5433

# --- Market data -------------------------------------------------------------
# fixture (default, offline, deterministic) | dukascopy (live, needs the extra)
MARKET_DATA_BACKEND=fixture
MARKET_DATA_FIXTURE_ROOT=tests/fixtures/market_data
DUKASCOPY_CACHE=data/cache/dukascopy
DUKASCOPY_BASE_URL=https://datafeed.dukascopy.com/datafeed
MARKET_DATA_TIMEOUT_SECONDS=30
# Consecutive missing bars above which a gap is flagged as a data-quality problem
# rather than a routine weekend/holiday break.
MARKET_DATA_MAX_GAP_BARS=3

# --- Kronos (Phase 5) --------------------------------------------------------
# mock (default) | local. `local` needs the [kronos] extra AND real weights.
KRONOS_BACKEND=mock
KRONOS_MODEL=kronos-small
KRONOS_WEIGHTS_DIR=
# UNVERIFIED assumption from the master plan — confirm against the upstream model
# card before Phase 5. See docs/financial-ai/IMPLEMENTATION_ROADMAP.md.
KRONOS_MAX_CONTEXT_BARS=512
KRONOS_FORECAST_HORIZON=12
KRONOS_SAMPLE_PATHS=1

# --- LLM (reporting/narration ONLY — never on the prediction path) -----------
LLM_BACKEND=mock
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
