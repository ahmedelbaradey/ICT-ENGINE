# --- Market data ---
# Raw and derived market data are large, immutable, and versioned by manifest —
# reproduce them from the ingest lane, never from git.
data/raw/
data/normalized/
data/features/
data/datasets/
*.parquet
*.csv
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet

# --- Models / artifacts ---
models/
artifacts/
mlruns/
*.pt
*.pth
*.onnx
*.pkl
*.joblib

# --- Kronos model weights (multi-GB, licensed separately) ---
weights/

