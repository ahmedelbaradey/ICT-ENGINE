# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Secrets — NEVER commit ---
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# --- Market data ---
# NOTHING under data/ is ever committed. Raw .bi5 payloads, derived Parquet and
# dataset manifests are large, reproducible from the ingest lane, and provenanced
# by hash in docs/financial-ai/DATA_PROOF.md. The whole tree is ignored rather
# than an enumerated subset, because a new subdirectory (cache/, manifests/, ...)
# must never silently become committable.
#
# ROOT-ANCHORED (`/data/`), not `data/`: a bare `data/` pattern matches a
# directory of that name at ANY depth, which would silently exclude the
# `ict_kronos/data/` source package.
/data/
*.parquet
*.csv
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet

# --- Models / artifacts ---
models/
artifacts/
mlruns/
*.pt
*.pth
*.onnx
*.pkl
*.joblib

# --- Kronos model weights (multi-GB, licensed separately) ---
weights/

# --- Reports ---
reports/
backtest_results/

# --- OS / editor ---
